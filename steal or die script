local function readMonAttr(inst)
	for _, a in ipairs(STRONG_ATTRS) do
		local ok, v = pcall(function() return inst:GetAttribute(a) end)
		if ok and v == true then
			local k = inst:GetAttribute("EntityKind")
			return tostring(k ~= nil and k or "ENTITY")
		end
	end
	for _, a in ipairs(KIND_ATTRS) do
		local ok, v = pcall(function() return inst:GetAttribute(a) end)
		if ok and v ~= nil and v ~= false then
			local s = tostring(v)
			if s ~= "" and matches(s, MON_WORDS) then return s end
		end
	end
	return nil
end

local function isMonsterPlayer(plr)
	local ch = plr.Character
	local kind = readMonAttr(plr) or (ch and readMonAttr(ch))
	if kind then return true, kind end
	if plr.Team and matches(plr.Team.Name, MON_WORDS) then return true, plr.Team.Name end
	if CS:HasTag(plr, "Monster") or CS:HasTag(plr, "Entity") then return true, "ENTITY" end
	if ch and (CS:HasTag(ch, "Monster") or CS:HasTag(ch, "Entity")) then return true, "ENTITY" end
	if ch then
		if matches(ch.Name, MON_WORDS) then return true, ch.Name end
		for _, d in ipairs(ch:GetChildren()) do
			if matches(d.Name, MON_WORDS) then return true, d.Name end
		end
	end
	return false
end

local function isMonsterNpc(model)
	if Players:GetPlayerFromCharacter(model) then return false end
	local kind = readMonAttr(model)
	if kind then return true, kind end
	if CS:HasTag(model, "Monster") or CS:HasTag(model, "Entity") then return true, "ENTITY" end
	if matches(model.Name, MON_WORDS) then return true, model.Name end
	for _, d in ipairs(model:GetChildren()) do
		if matches(d.Name, MON_WORDS) then return true, d.Name end
	end
	return false
end

local function rescan()
	if not Config.Enabled then return end
	local found = {}
	local chars = {}

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then chars[plr.Character] = true end
	end

	local function inChar(inst)
		local p = inst
		while p and p ~= Workspace do
			if chars[p] then return true end
			p = p.Parent
		end
		return false
	end

	local function ancFound(inst)
		local p = inst.Parent
		while p and p ~= Workspace do
			if found[p] then return true end
			p = p.Parent
		end
		return false
	end

	-- PROMPTS: closets, portas, itens
	for _, prompt in ipairs(Workspace:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") and prompt.Enabled then
			local cand = prompt.Parent
			if cand and cand ~= Workspace and not inChar(cand) and not found[cand] then
				local nm  = cand.Name
				local txt = tostring(prompt.ActionText) .. " " .. tostring(prompt.ObjectText)
				local all = nm .. " " .. txt

				if matches(all, CLOSET_KEYS) then
					if Config.Closets then
						found[cand] = true
						createEsp(cand, "closet", C_CLOSET, "ESCONDERIJO " .. short(nm, 12))
					end
				elseif matches(all, DOOR_KEYS) then
					if Config.Doors then
						found[cand] = true
						createEsp(cand, "door", C_DOOR, "PORTA " .. short(nm, 14))
					end
				elseif Config.Items then
					if matches(txt, ITEM_GOOD) or matches(nm, ITEM_GOOD) or hasValueAttr(cand) then
						found[cand] = true
						createEsp(cand, "item", C_ITEM, short(nm, 22))
					end
				end
			end
		end
	end

	-- CLOSETS por nome
	if Config.Closets then
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and not inChar(obj) and not found[obj] and not ancFound(obj)
				and matches(obj.Name, CLOSET_KEYS) and not matches(obj.Name, DOOR_KEYS) then
				found[obj] = true
				createEsp(obj, "closet", C_CLOSET, "ESCONDERIJO " .. short(obj.Name, 12))
			end
		end
	end

	-- PORTAS por nome
	if Config.Doors then
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and not inChar(obj) and not found[obj] and not ancFound(obj)
				and matches(obj.Name, DOOR_KEYS) and not matches(obj.Name, CLOSET_KEYS) then
				found[obj] = true
				createEsp(obj, "door", C_DOOR, "PORTA " .. short(obj.Name, 14))
			end
		end
	end

	-- ITENS por atributo de valor
	if Config.Items then
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and not inChar(obj) and not found[obj] and not ancFound(obj)
				and hasValueAttr(obj) and not matches(obj.Name, CLOSET_KEYS)
				and not matches(obj.Name, DOOR_KEYS) and not isMonsterNpc(obj) then
				found[obj] = true
				createEsp(obj, "item", C_ITEM, short(obj.Name, 22))
			end
		end
	end

	-- PLAYERS
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local isMon, kind = isMonsterPlayer(plr)
				if isMon then
					if Config.Monster then
						found[plr.Character] = true
						createEsp(plr.Character, "monster", C_MONSTER,
							"ENTIDADE [" .. short(kind, 12) .. "] " .. short(plr.DisplayName, 12))
					end
				elseif Config.Survivors then
					found[plr.Character] = true
					createEsp(plr.Character, "survivor", C_SURV, short(plr.DisplayName, 14))
				end
			end
		end
	end

	-- ENTIDADE NPC (rodada ENTITY: AI)
	if Config.Monster then
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not found[obj] then
				local isMon, kind = isMonsterNpc(obj)
				if isMon then
					found[obj] = true
					createEsp(obj, "monster", C_MONSTER, "ENTIDADE [" .. short(kind, 12) .. "]")
				end
			end
		end
	end

	for obj in pairs(Store) do
		if not obj.Parent or not found[obj] then destroyEsp(obj) end
	end
end

