local C_MONSTER = Color3.fromRGB(255,60,60)

local ITEM_GOOD = {"phone","wallet","gold","laptop","ring","watch","camera","vase","painting",
	"jewel","gem","coin","cash","silver","diamond","statue","clock","necklace","bracelet",
	"tablet","console","bar","artifact","treasure","valuable","steal","pick","grab","take","loot"}
local CLOSET_KEYS = {"closet","locker","wardrobe","cabinet","hide","hiding","cupboard"}
local DOOR_KEYS   = {"door","gate","exit","entrance","barricade"}
local MON_WORDS   = {"entity","monster","locust","hollow","hunter","creature","killer","beast",
	"wendell","rictus","stalker","brute"}
local STRONG_ATTRS = {"IsEntity","IsMonster","Monster","Entity"}
local KIND_ATTRS   = {"EntityKind","MonsterKind","EntityType"}

local Store = {}

local function lower(s) return string.lower(tostring(s)) end

local function matches(t, list)
	t = lower(t)
	for _, k in ipairs(list) do
		if string.find(t, k, 1, true) then return true end
	end
	return false
end

local function short(s, n)
	s = tostring(s)
	if #s > n then return s:sub(1, n) .. "..." end
	return s
end

local function anchorOf(o)
	if o:IsA("BasePart") then return o end
	if o:IsA("Model") then return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true) end
	return nil
end

local function hasValueAttr(o)
	for a in pairs(o:GetAttributes()) do
		local s = lower(a)
		if s:find("value") or s:find("weight") or s:find("price")
			or s:find("worth") or s:find("rarity") or s:find("cost") then
			return true
		end
	end
	return false
end

local function createEsp(obj, kind, color, text)
	if Store[obj] then return end
	local a = anchorOf(obj)
	if not a then return end

	local bill = Instance.new("BillboardGui")
	bill.Name = "VH_ESP"
	bill.Size = UDim2.fromOffset(260, 26)
	bill.StudsOffsetWorldSpace = Vector3.new(0, 1.4, 0)
	bill.AlwaysOnTop = true
	bill.MaxDistance = Config.MaxDist
	bill.Adornee = a
	bill.Parent = a

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Txt"
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = kind == "monster" and 14 or 13
	lbl.TextColor3 = color
	lbl.TextStrokeTransparency = 0.2
	lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
	lbl.Text = text
	lbl.Parent = bill

	local hl
	if Config.Highlight or Config.Chams then
		hl = Instance.new("Highlight")
		hl.Name = "VH_HL"
		hl.Adornee = obj
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillColor = color
		hl.OutlineColor = color
		hl.FillTransparency = Config.Chams and (kind == "monster" and 0.35 or 0.6) or 1
		hl.OutlineTransparency = Config.Highlight and 0.05 or 1
		hl.Parent = obj
	end

	Store[obj] = { Label = lbl, Bill = bill, HL = hl, Kind = kind, Name = text }
end

local function destroyEsp(obj)
	local d = Store[obj]
	if not d then return end
	if d.Bill then d.Bill:Destroy() end
	if d.HL then d.HL:Destroy() end
	Store[obj] = nil
end

local function clearAll()
	local ks = {}
	for k in pairs(Store) do ks[#ks + 1] = k end
	for _, k in ipairs(ks) do destroyEsp(k) end
end

local function refreshVisuals()
	for _, d in pairs(Store) do
		if d.HL then
			d.HL.FillTransparency = Config.Chams and (d.Kind == "monster" and 0.35 or 0.6) or 1
			d.HL.OutlineTransparency = Config.Highlight and 0.05 or 1
		end
	end
end

RunService.RenderStepped:Connect(function()
	if not Config.Enabled then return end
	local cp = Camera.CFrame.Position
	for obj, d in pairs(Store) do
		if not obj.Parent then
			destroyEsp(obj)
			continue
		end
		local a = anchorOf(obj)
		if a then
			local dist = (a.Position - cp).Magnitude
			d.Label.Text = Config.Distance and (d.Name .. "  [" .. math.floor(dist) .. "m]") or d.Name
			local vis = dist <= Config.MaxDist
			d.Bill.Enabled = vis
			if d.HL then d.HL.Enabled = vis end
		end
	end
end)--=============================================================
